rules_version = '2';

// Tutta la logica di scrittura su ordini, serate e utenti passa dalle Cloud
// Functions, che usano l'Admin SDK e quindi non sono soggette a queste regole.
//
// I permessi sono "custom claims" dell'account, impostabili solo dal server:
// "amministratore" (generale, può tutto) e una chiave per app con il ruolo in
// quell'app (es. comande: "cassa"). Un account senza permessi — ad esempio
// uno che qualcuno si è registrato da solo — non accede a nulla di riservato.
service cloud.firestore {
  match /databases/{database}/documents {

    function amministratore() {
      return request.auth != null && request.auth.token.get('amministratore', false) == true;
    }

    function personaleComande() {
      return amministratore()
        || (request.auth != null
            && request.auth.token.get('comande', []).hasAny(
                 ['cassa', 'cucina', 'griglia', 'bar', 'distribuzione', 'bancoBar', 'bancoBevande']));
    }

    // Chi lavora a un banco preciso. Il menù di un banco se lo gestisce chi ci
    // sta dietro, quindi qui le scritture dal client sono permesse — a
    // differenza degli ordini, che passano sempre dalle Cloud Functions.
    // Scritto banco per banco e non con una formula: un id sconosciuto non
    // deve cadere per sbaglio nel ramo di qualcun altro.
    function ruoloDelBanco(banco) {
      return request.auth != null
        && ((banco == 'bar' && request.auth.token.get('comande', []).hasAny(['bancoBar']))
            || (banco == 'bevande' && request.auth.token.get('comande', []).hasAny(['bancoBevande'])));
    }

    // Menu: lettura pubblica (serve alla pagina QR non autenticata),
    // modifiche riservate all'amministratore.
    match /prodotti/{prodottoId} {
      allow read: if true;
      allow write: if amministratore();
    }

    // Portate del menù (Primi, Secondi, ...): stesso trattamento dei piatti.
    match /categorie/{categoriaId} {
      allow read: if true;
      allow write: if amministratore();
    }

    // Componenti dei piatti (pollo, salsiccia...) e il settore che li prepara:
    // servono al personale, non al cliente del QR.
    match /componenti/{componenteId} {
      allow read: if personaleComande();
      allow write: if amministratore();
    }

    // Impaginazione dei biglietti stampati e immagini che ci finiscono dentro:
    // le compone l'amministratore, le legge chi stampa (cassa e distribuzione).
    match /biglietti/{bigliettoId} {
      allow read: if personaleComande();
      allow write: if amministratore();
    }

    match /immagini/{immagineId} {
      allow read: if personaleComande();
      allow write: if amministratore();
    }

    // Menù dei banchi (BAR, BEVANDE): lo compila chi sta a quel banco, e
    // l'amministratore che può tutto. Lo leggono tutti gli altri del
    // personale, non il cliente dal QR: al banco si ordina di persona.
    match /banchi/{banco} {
      allow read: if personaleComande();
      allow write: if false;

      match /categorie/{categoriaId} {
        allow read: if personaleComande();
        allow write: if amministratore() || ruoloDelBanco(banco);
      }

      match /prodotti/{prodottoId} {
        allow read: if personaleComande();
        allow write: if amministratore() || ruoloDelBanco(banco);
      }
    }

    match /serate/{serataId} {
      allow read: if personaleComande();
      allow write: if false;

      // Ordini battuti ai banchi. Li scrivono solo le Cloud Functions, come
      // tutti gli altri ordini: il totale della serata non può dipendere da
      // quello che un client si mette in testa di mandare.
      match /ordiniBanco/{ordineId} {
        allow read: if personaleComande();
        allow write: if false;
      }

      match /ordini/{ordineId} {
        allow read: if personaleComande();
        allow write: if false;
      }

      match /sottoOrdini/{sottoOrdineId} {
        allow read: if personaleComande();
        allow write: if false;
      }

      // Porzioni vendute e residue: il cliente dal QR non deve vederle, lui
      // sa solo se un piatto è finito (campo esauritoSerata del prodotto).
      match /disponibilita/{prodottoId} {
        allow read: if personaleComande();
        allow write: if false;
      }
    }

    // Profilo utente: ognuno legge il proprio, l'amministratore tutti.
    match /utenti/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || amministratore());
      allow write: if false;
    }

    match /config/{documento} {
      allow read, write: if false;
    }
  }
}

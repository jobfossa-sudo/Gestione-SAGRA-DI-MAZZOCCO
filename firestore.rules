rules_version = '2';

// Tutta la logica di scrittura (creazione ordini, cambi di stato, ecc.) passa
// dalle Cloud Functions, che usano l'Admin SDK e quindi non sono soggette a
// queste regole. Da qui i client (cassa, reparto, consegna, QR) possono solo
// leggere, mai scrivere direttamente su ordini/sotto-ordini.
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu: lettura pubblica (serve anche alla pagina QR non autenticata),
    // scrittura riservata a utenti autenticati (staff che gestisce il menu).
    match /prodotti/{prodottoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /serate/{serataId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /ordini/{ordineId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /sottoOrdini/{sottoOrdineId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}

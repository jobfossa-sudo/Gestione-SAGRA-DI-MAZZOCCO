rules_version = '2';

// Placeholder: nega tutto. Le regole vere vengono scritte nello Step 1 del
// piano (modello dati e sicurezza). NON ancora distribuito al progetto live,
// che resta in modalità test fino a quel momento.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

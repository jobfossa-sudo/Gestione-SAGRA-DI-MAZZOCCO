{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "emulators": {
    "auth": { "port": 9098 },
    "functions": { "port": 5002 },
    "firestore": { "port": 8081 },
    "hub": { "port": 4401 },
    "logging": { "port": 4501 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
